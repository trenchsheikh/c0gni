// Simplified schema without pgvector for initial testing
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  publicKey String?  @unique
  
  // Profile information
  avatar    String?
  bio       String?
  timezone  String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  chats           Chat[]
  messages        Message[]
  memories        UserMemory[]
  contexts        UserContext[]
  subscriptions   Subscription[]

  @@map("users")
}

// ============================================================================
// CHAT SYSTEM
// ============================================================================

model Chat {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  
  // Chat settings
  model       String?  @default("openai/gpt-4o")
  temperature Float?   @default(0.7)
  maxTokens   Int?     @default(4000)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  
  // Message content
  role      String   // "user" | "assistant" | "system" | "tool"
  content   String
  
  // Message metadata
  metadata  Json?    // Tool calls, thinking process, etc.
  tokens    Int?     // Token count for this message
  model     String?  // Model used to generate this message
  
  // Processing information
  toolCalls Json?    // Tools used in this message
  thinking  String?  // AI thinking process (stored separately)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ============================================================================
// MEMORY SYSTEM - Simplified without pgvector
// ============================================================================

model UserMemory {
  id          String   @id @default(cuid())
  userId      String
  
  // Memory classification
  type        String   // "preference" | "fact" | "context" | "skill" | "blockchain_knowledge"
  category    String   // "trading" | "defi" | "technical_analysis" | etc.
  
  // Memory content
  key         String   // Descriptive key
  value       String   // Actual value or description
  confidence  Float    @default(1.0) // Confidence level 0.0 - 1.0
  
  // Source and verification
  source      String   @default("conversation")
  messageId   String?  // Reference to source message if applicable
  
  // Blockchain-specific fields
  chainId     Int?     // Blockchain network ID if applicable
  tokenAddress String? // Token contract address if memory is token-specific
  protocol    String?  // DeFi protocol if applicable
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsed    DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, key])
  @@index([userId, type])
  @@index([userId, category])
  @@map("user_memories")
}

// User context and communication patterns
model UserContext {
  id                     String   @id @default(cuid())
  userId                 String
  
  // Communication preferences
  communicationStyle     String?  // "formal" | "casual" | "technical" | "friendly"
  preferredResponseStyle String?  // "detailed" | "concise" | "examples" | "step-by-step"
  
  // Interest areas (blockchain-focused)
  topicsOfInterest       String[] @default([])
  expertiseAreas         String[] @default([])
  tradingExperience      String?  // "beginner" | "intermediate" | "advanced"
  
  // Technical preferences
  preferredChains        String[] @default([]) // ["ethereum", "solana", "polygon"]
  riskTolerance         String?  // "conservative" | "moderate" | "aggressive"
  
  // Analysis patterns
  conversationPattern    Json?    // Detailed conversation analysis
  timezone              String?
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@map("user_contexts")
}

// ============================================================================
// SUBSCRIPTION AND BILLING
// ============================================================================

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  
  // Subscription details
  planType     String   // "free" | "pro" | "enterprise"
  status       String   // "active" | "canceled" | "past_due" | "unpaid"
  
  // Usage limits
  monthlyMessageLimit Int? @default(100)
  currentMonthUsage   Int  @default(0)
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  periodStart  DateTime @default(now())
  periodEnd    DateTime?
  
  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@map("subscriptions")
}